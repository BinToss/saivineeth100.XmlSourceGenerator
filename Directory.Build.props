<Project>

  <PropertyGroup>
    <!-- Package Metadata -->
    <Authors>Saivineeth</Authors>
    <Company>Saivineeth</Company>
    <Product>XmlSourceGenerator</Product>
    <Description>High-performance XML serialization via source generation with XmlSerializer feature parity</Description>
    <Copyright>Copyright © $(Authors) 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/saivineeth100/XmlSourceGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/saivineeth100/XmlSourceGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>xml;serialization;source-generator;roslyn;performance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>


    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Build Settings -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Optional: Output the generated files to the obj\GeneratedFiles folder  -->
    <EmitCompilerGeneratedFiles>True</EmitCompilerGeneratedFiles>

    <!-- Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
  </ItemGroup>

  <PropertyGroup>
    <RepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), '.git/index'))</RepoRoot>
    <_HCESharedDirSuffix>node_modules/@halospv3/hce.shared-config/</_HCESharedDirSuffix>
    <HCESharedDir>$(RepoRoot)$(_HCESharedDirSuffix)</HCESharedDir>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile> -->
    <!-- <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode> -->
    <NuGetLockFilePath Condition="'$(Configuration)' != Release">$(MSBuildProjectDirectory)/packages-debug.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(Configuration)' == Debug AND Exists('$(MSBuildProjectDirectory)/packages.$(_MSBuildProjectNameUnderscored).lock.json')">
      $(MSBuildProjectDirectory)/packages-debug.$(_MSBuildProjectNameUnderscored).lock.json
    </NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Label="Yarn-unplugged HCE.Shared" Condition="!Exists($(HCESharedDir))">
    <_yarnUnplugged>$([System.IO.Path]::Join("$(RepoRoot)", '.yarn/unplugged/'))</_yarnUnplugged>
    <_yarnUnpluggedChildren Condition="Exists($(_yarnUnplugged))">$([System.IO.Directory]::GetDirectories($(_yarnUnplugged)))</_yarnUnpluggedChildren>
    <_yarnUnpluggedHceSharedMatches>$([System.Text.RegularExpressions.Regex]::Matches(
      "$(_yarnUnpluggedChildren)",'@halospv3-hce.shared-config-[^;]+')
      )</_yarnUnpluggedHceSharedMatches>
    <_yarnUnplugged_lastMatch>$([MSBuild]::Subtract(
      $(_yarnUnpluggedHceSharedMatches.Split(';').Length),
      1
      ))</_yarnUnplugged_lastMatch>
    <HCESharedDir>$(_yarnUnplugged)$(_yarnUnpluggedHceSharedMatches.Split(';')[$(_yarnUnplugged_lastMatch)])/$(_HCESharedDirSuffix)</HCESharedDir>
  </PropertyGroup>

  <Import Project="$(HCESharedDir)dotnet/HCE.Shared.CI.props" />
  <Import Project="$(HCESharedDir)dotnet/ZipPublishDir.targets" />
  <!-- Must be explicitly targeted via 'dotnet restore project.csproj -t:PublishAll'. May lead to incompatibility errors -->
  <Import Project="$(HCESharedDir)dotnet/PublishAll.targets" />
  <!-- Auto-runs after 'dotnet build' if (TargetFramework != '') AND (RuntimeIdentifier == '') AND (RuntimeIdentifiers != '');
    The SDK iterates through TargetFrameworks for each TFM. We iterate each TFM's RIDs.
    Intended for ensuring RID-dependent build permutations are successful before attempting PublishAll. -->
  <Import Project="$(HCESharedDir)dotnet/BuildEachRID.targets" />

</Project>
